<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TimeTracker.App.MainWindow"
        Title="Time Tracker"
        Width="360" SizeToContent="Height"
        CanResize="False"
        SystemDecorations="None"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Background="#1E1E1E">
  <Border x:Name="Root" BorderBrush="#3A96DD" BorderThickness="1" Background="#1E1E1E" Padding="10">
    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
      <TextBox x:Name="DescriptionBox" Grid.Row="0" Grid.Column="0" Watermark="What are you working on?"
               MaxLength="500" VerticalAlignment="Center" />
      <Button x:Name="CloseButton" Grid.Row="0" Grid.Column="1" Content="✕" Margin="6,0,0,0"
              Padding="8,4" Background="Transparent" ToolTip.Tip="Hide to tray" />
      <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,0">
        <TextBlock x:Name="ElapsedText" Text="00:00:00" FontSize="28" FontFamily="Consolas,Menlo,monospace"
                   VerticalAlignment="Center" />
        <TextBlock x:Name="TotalText" Grid.Column="1" Text="Today 00:00" FontSize="13" Opacity="0.7"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button x:Name="PauseButton" Width="44" Height="44" CornerRadius="22" IsVisible="False"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  Foreground="White" FontSize="18" Padding="0" />
          <Button x:Name="ToggleButton" Width="44" Height="44" CornerRadius="22"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  Foreground="White" FontSize="18" Padding="0" />
        </StackPanel>
      </Grid>
      <Expander x:Name="TodayExpander" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0" IsExpanded="False"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="Today">
        <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="TodayList" />
        </ScrollViewer>
      </Expander>
    </Grid>
  </Border>
</Window>
