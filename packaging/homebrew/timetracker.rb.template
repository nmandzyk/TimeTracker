class Timetracker < Formula
  desc "Small, portable, always-on-top time tracker with a local HTTP API"
  homepage "https://github.com/nmandzyk/TimeTracker"
  version "{{VERSION}}"
  license "MIT"

  on_macos do
    on_arm do
      url "{{OSX_ARM64_URL}}"
      sha256 "{{OSX_ARM64_SHA256}}"
    end
    on_intel do
      url "{{OSX_X64_URL}}"
      sha256 "{{OSX_X64_SHA256}}"
    end
  end

  on_linux do
    on_intel do
      url "{{LINUX_X64_URL}}"
      sha256 "{{LINUX_X64_SHA256}}"
    end
  end

  def install
    bin.install "TimeTracker"
  end

  test do
    assert_predicate bin/"TimeTracker", :executable?
  end
end
